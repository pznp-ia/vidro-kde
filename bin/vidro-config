#!/usr/bin/env python3
"""vidro-config — Vidro settings (~/.config/vidrorc).

  vidro-config get <Group> <key>
  vidro-config set <Group> <key> <value> [--apply]
  vidro-config json                 all settings (with defaults / current system values) as JSON
  vidro-config apply [module...]    apply modules (default: all)
  vidro-config modules              list modules and their groups

Modules: ~/.local/share/vidro/modules/<name>.py — see _common.py for the module API.
Settings written with the Portuguese names of older versions are migrated automatically.
(Old Portuguese subcommands still work: aplicar, modulos.)
"""
import configparser, importlib.util, json, os, sys

DATA = os.environ.get('XDG_DATA_HOME', os.path.expanduser('~/.local/share'))
CONFIG_FILE = os.path.join(os.environ.get('XDG_CONFIG_HOME', os.path.expanduser('~/.config')), 'vidrorc')
MODULES = os.path.join(DATA, 'vidro', 'modules')
sys.path.insert(0, MODULES)


def load():
    if os.path.exists(CONFIG_FILE):
        try:
            import _migrate
            _migrate.migrate(CONFIG_FILE)
        except ImportError:
            pass
    c = configparser.RawConfigParser(); c.optionxform = str
    c.read(CONFIG_FILE)
    return c


def save(c):
    tmp = CONFIG_FILE + '.tmp'
    with open(tmp, 'w') as f:
        c.write(f)
    os.replace(tmp, CONFIG_FILE)


def modules():
    out = {}
    if os.path.isdir(MODULES):
        for n in sorted(os.listdir(MODULES)):
            if n.endswith('.py') and not n.startswith('_'):
                spec = importlib.util.spec_from_file_location('vidro_module_' + n[:-3], os.path.join(MODULES, n))
                m = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(m)
                out[n[:-3]] = m
    return out


def values(c, m):
    """Defaults < current system values (if the module reads them) < vidrorc."""
    d = dict(getattr(m, 'DEFAULTS', {}))
    if hasattr(m, 'current'):
        try:
            d.update({k: v for k, v in (m.current() or {}).items() if k in d})
        except Exception as e:
            print(f'{getattr(m, "GROUP", "?")}: could not read the current state ({e})', file=sys.stderr)
    g = getattr(m, 'GROUP', None)
    if g and c.has_section(g):
        d.update(dict(c.items(g)))
    return d


def main(a):
    if not a:
        print(__doc__); return 1
    cmd = {'aplicar': 'apply', 'modulos': 'modules'}.get(a[0], a[0])
    c = load()
    if cmd == 'get' and len(a) == 3:
        group, key = a[1], a[2]
        if c.has_option(group, key):
            print(c.get(group, key)); return 0
        for m in modules().values():
            if getattr(m, 'GROUP', None) == group and key in getattr(m, 'DEFAULTS', {}):
                print(m.DEFAULTS[key]); return 0
        return 1
    if cmd == 'set' and len(a) >= 4:
        group, key, value = a[1], a[2], a[3]
        if not c.has_section(group):
            c.add_section(group)
        c.set(group, key, value)
        save(c)
        if '--apply' in a[4:] or '--aplicar' in a[4:]:
            for m in modules().values():
                if getattr(m, 'GROUP', None) == group:
                    m.apply(values(c, m))
        return 0
    if cmd == 'json':
        print(json.dumps({getattr(m, 'GROUP', n): values(c, m) for n, m in modules().items()}, ensure_ascii=False))
        return 0
    if cmd == 'apply':
        ms = modules()
        for n in (a[1:] or list(ms)):
            if n in ms:
                ms[n].apply(values(c, ms[n]))
            else:
                print('unknown module:', n, file=sys.stderr)
        return 0
    if cmd == 'modules':
        for n, m in modules().items():
            print(n, getattr(m, 'GROUP', ''))
        return 0
    print(__doc__); return 1


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
