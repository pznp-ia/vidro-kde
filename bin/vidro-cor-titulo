#!/bin/bash
# Ajusta o tema de janelas Vidro (vidro + texto) ao brilho do papel de parede.
# Uso: vidro-cor-titulo [--force]
THEME=~/.local/share/aurorae/themes/Vidro
STATE=~/.cache/vidro-cor-titulo
CFG=~/.config/plasma-org.kde.plasma.desktop-appletsrc
img=$(python3 -I - "$CFG" <<'PY'
import sys, re, urllib.parse
s = open(sys.argv[1]).read()
# pega o Image= do papel de parede (org.kde.image) do primeiro desktop
for m in re.finditer(r'^\[Containments\]\[(\d+)\]\[Wallpaper\]\[org\.kde\.image\]\[General\]\n((?:[^\[\n].*\n?)*)', s, re.M):
    im = re.search(r'^Image=(.*)$', m.group(2), re.M)
    if im:
        print(urllib.parse.unquote(im.group(1).replace('file://', ''))); break
PY
)
# papel de parede pode ser um pacote (pasta) -> escolhe a maior imagem dentro
if [ -d "$img" ]; then img=$(find "$img" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -printf '%s %p\n' | sort -n | tail -1 | cut -d' ' -f2-); fi
[ -f "$img" ] || { echo "papel de parede não encontrado: $img"; exit 0; }
# fundo desfocado para a tela de logout Vidro (só refaz se o papel de parede mudou)
BLUR=~/.cache/vidro/fundo-desfocado.jpg; mkdir -p ~/.cache/vidro
if [ "$1" = "--force" ] || [ ! -f "$BLUR" ] || [ "$(cat ~/.cache/vidro/fundo.src 2>/dev/null)" != "$img" ]; then
  magick "$img" -resize 1280x -blur 0x28 -modulate 92,135 -quality 88 "$BLUR.tmp" 2>/dev/null && mv "$BLUR.tmp" "$BLUR" && echo "$img" > ~/.cache/vidro/fundo.src
fi
# brilho médio (0-1), dando mais peso à metade de cima, onde as barras costumam ficar
lum=$(magick "$img" -resize 200x200! -colorspace Gray \( +clone -crop 200x100+0+0 \) -delete 0 -format '%[fx:mean]' info: 2>/dev/null)
[ -n "$lum" ] || exit 0
mode=$(python3 -I -c "print('claro' if $lum > 0.58 else 'escuro')")
key="$img|$mode"
if [ "$1" != "--force" ] && [ -f "$STATE" ] && [ "$(cat "$STATE")" = "$key" ]; then exit 0; fi
python3 -I "$THEME/fonte/gerar-vidro.py" "$THEME" "$mode" >/dev/null
echo "$key" > "$STATE"
# força o KWin a recarregar o SVG: troca de tema e volta
K() { kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 "$@"; }
R() { dbus-send --session --type=method_call --dest=org.kde.KWin /KWin org.kde.KWin.reconfigure; }
K --key library org.kde.breeze; K --key theme Breeze; R; sleep 0.5
K --key library org.kde.kwin.aurorae.v2; K --key theme __aurorae__svg__Vidro; R
echo "brilho=$lum -> $mode ($img)"
