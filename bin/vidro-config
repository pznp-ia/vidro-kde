#!/usr/bin/env python3
"""vidro-config — configurações do Vidro (~/.config/vidrorc).

  vidro-config get <Grupo> <chave>
  vidro-config set <Grupo> <chave> <valor> [--aplicar]
  vidro-config json                 todas as configurações (com padrões) em JSON
  vidro-config aplicar [modulo...]  aplica os módulos (padrão: todos)
  vidro-config modulos              lista os módulos

Módulos: ~/.local/share/vidro/modulos/<nome>.py, cada um com
  GRUPO = "Nome"            grupo no vidrorc
  PADROES = {chave: valor}  valores padrão (strings)
  def aplicar(cfg): ...     cfg = dict com os valores do grupo (já com padrões)
"""
import configparser, importlib.util, json, os, sys

CFG = os.path.join(os.environ.get('XDG_CONFIG_HOME', os.path.expanduser('~/.config')), 'vidrorc')
MOD = os.path.join(os.environ.get('XDG_DATA_HOME', os.path.expanduser('~/.local/share')), 'vidro', 'modulos')


def ler():
    c = configparser.RawConfigParser(); c.optionxform = str
    c.read(CFG)
    return c


def gravar(c):
    tmp = CFG + '.tmp'
    with open(tmp, 'w') as f:
        c.write(f)
    os.replace(tmp, CFG)


def modulos():
    out = {}
    if os.path.isdir(MOD):
        for n in sorted(os.listdir(MOD)):
            if n.endswith('.py') and not n.startswith('_'):
                spec = importlib.util.spec_from_file_location('vidro_mod_' + n[:-3], os.path.join(MOD, n))
                m = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(m)
                out[n[:-3]] = m
    return out


def grupo(c, m):
    d = dict(getattr(m, 'PADROES', {}))
    if hasattr(m, 'atual'):          # módulos que leem o estado de agora do sistema (painel, menu...)
        try:
            d.update({k: v for k, v in (m.atual() or {}).items() if k in d})
        except Exception as e:
            print(f'{getattr(m, "GRUPO", "?")}: não consegui ler o estado atual ({e})', file=sys.stderr)
    g = getattr(m, 'GRUPO', None)
    if g and c.has_section(g):
        d.update(dict(c.items(g)))
    return d


def main(a):
    if not a:
        print(__doc__); return 1
    cmd = a[0]
    c = ler()
    if cmd == 'get' and len(a) == 3:
        g, k = a[1], a[2]
        for m in modulos().values():
            if getattr(m, 'GRUPO', None) == g:
                print(grupo(c, m).get(k, '')); return 0
        print(c.get(g, k, fallback='')); return 0
    if cmd == 'set' and len(a) >= 4:
        g, k, v = a[1], a[2], a[3]
        if not c.has_section(g):
            c.add_section(g)
        c.set(g, k, v); gravar(c)
        if '--aplicar' in a:
            for n, m in modulos().items():
                if getattr(m, 'GRUPO', None) == g:
                    m.aplicar(grupo(c, m))
        return 0
    if cmd == 'json':
        d = {s: dict(c.items(s)) for s in c.sections()}
        for m in modulos().values():
            g = getattr(m, 'GRUPO', None)
            if g:
                d[g] = grupo(c, m)
        print(json.dumps(d, ensure_ascii=False)); return 0
    if cmd == 'aplicar':
        ms = modulos()
        for n in (a[1:] or list(ms)):
            if n in ms:
                ms[n].aplicar(grupo(c, ms[n]))
            else:
                print('módulo desconhecido:', n, file=sys.stderr)
        return 0
    if cmd == 'modulos':
        for n, m in modulos().items():
            print(n, getattr(m, 'GRUPO', ''))
        return 0
    print(__doc__); return 1


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
