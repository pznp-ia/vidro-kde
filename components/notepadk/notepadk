#!/bin/bash
# NotepadK: Kate with its own configuration and a focus mode (only the writing area).
BASE="$HOME/.local/share/notepadk"
CONF="$BASE/config"
mkdir -p "$CONF"
# reuses the KDE settings (colors, fonts, style, global shortcuts...) through links,
# but keeps the Kate/editor files separate.
for f in "$HOME/.config"/* "$HOME/.config"/.[!.]*; do
  [ -e "$f" ] || continue
  n=$(basename "$f")
  case "$n" in kate*|ktexteditor*|katevirc|kateschemarc|katemetainfos|katepartrc) continue ;; esac
  [ -e "$CONF/$n" ] || [ -L "$CONF/$n" ] || ln -s "$f" "$CONF/$n"
done
# first run: enable the plugin and set a clean writing look
if [ ! -f "$CONF/katerc" ]; then
  cat > "$CONF/katerc" <<'RC'
[Kate Plugins]
vidrofocusplugin=true

[General]
Show Full Path in Title=false
Show Tab Bar=false
Show Url Nav Bar=false
Startup Session=new

[Notification Messages]
Kate hide sidebars notification message=false

RC
fi
# own data (separate Kate sessions), reusing the rest of ~/.local/share
DATA="$BASE/data"
mkdir -p "$DATA/kate"
for f in "$HOME/.local/share"/*; do
  n=$(basename "$f")
  case "$n" in kate|notepadk) continue ;; esac
  [ -e "$DATA/$n" ] || [ -L "$DATA/$n" ] || ln -s "$f" "$DATA/$n"
done
if [ ! -f "$DATA/kate/anonymous.katesession" ]; then
  printf '[Kate Plugins]\nvidrofocusplugin=true\nkatefiletreeplugin=true\nkatesearchplugin=true\nkateprojectplugin=true\nkatekonsoleplugin=true\nlspclientplugin=true\n' > "$DATA/kate/anonymous.katesession"
fi
export XDG_DATA_HOME="$DATA"
export VIDRO_FOCUS=1
export XDG_CONFIG_HOME="$CONF"
export QT_PLUGIN_PATH="$BASE/install/lib64/plugins${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"
exec kate -n "$@"
