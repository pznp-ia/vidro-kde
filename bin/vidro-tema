#!/bin/bash
# vidro-tema ligar|desligar|estado
#   ligar    → tudo do Vidro (tema global, efeitos, transparência, bloqueio/logout)
#   desligar → Breeze Dark padrão do Plasma (para comparar "antes/depois")
# O painel, papel de parede e seus arquivos NÃO são apagados — só alterna.
set -u
K() { kwriteconfig6 "$@"; }
fx() { # liga/desliga efeitos do KWin na hora e no kwinrc
    for e in "$@"; do
        n=${e%=*}; v=${e#*=}
        K --file kwinrc --group Plugins --key "${n}Enabled" "$v"
        if [ "$v" = true ]; then m=loadEffect; else m=unloadEffect; fi
        dbus-send --session --dest=org.kde.KWin /Effects org.kde.kwin.Effects.$m string:$n
    done
}
LOGOUT=~/.local/share/dbus-1/services/org.kde.LogoutPrompt.service
UNION_DIR=~/.local/share/union/styles/vidro
KWINENV=~/.config/systemd/user/plasma-kwin_wayland.service.d/vidro.conf

case "${1:-estado}" in
ligar)
    plasma-apply-lookandfeel -a org.vidro.desktop >/dev/null 2>&1
    if [ -d "$UNION_DIR" ]; then
        K --file kdeglobals --group KDE --key widgetStyle Union
        K --file kdeglobals --group KDE --key unionStyle vidro
    else
        K --file kdeglobals --group KDE --key widgetStyle Breeze   # sem Union: estilo Breeze
    fi
    K --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnLeft XIA
    K --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnRight ""
    fx squash=false maximize=false fadingpopups=false slidingpopups=false \
       vidro_minimize=true vidro_maximize=true vidro_popups=true vidro_opacity=true
    [ -f "$LOGOUT.off" ] && mv "$LOGOUT.off" "$LOGOUT"
    [ -f "$KWINENV.off" ] && mv "$KWINENV.off" "$KWINENV"
    # painel translúcido
    dbus-send --session --dest=org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript \
        string:'panels().forEach(function(p){ p.opacity = "translucent"; })' >/dev/null 2>&1
    ~/.local/bin/vidro-cor-titulo --force >/dev/null 2>&1
    echo "Vidro ligado."
    ;;
desligar)
    plasma-apply-lookandfeel -a org.kde.breezedark.desktop >/dev/null 2>&1
    K --file kdeglobals --group KDE --key widgetStyle Breeze
    K --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnLeft MS
    K --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnRight HIAX
    fx vidro_minimize=false vidro_maximize=false vidro_popups=false vidro_opacity=false \
       squash=true maximize=true fadingpopups=true
    [ -f "$LOGOUT" ] && mv "$LOGOUT" "$LOGOUT.off"
    [ -f "$KWINENV" ] && mv "$KWINENV" "$KWINENV.off"
    echo "Breeze Dark (padrão) ligado."
    ;;
estado)
    lnf=$(kreadconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage)
    echo "Tema global: $lnf"; exit 0
    ;;
*) echo "uso: vidro-tema ligar|desligar|estado"; exit 1 ;;
esac
systemctl --user daemon-reload
busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus ReloadConfig >/dev/null 2>&1
dbus-send --session --type=method_call --dest=org.kde.KWin /KWin org.kde.KWin.reconfigure
echo "(Apps já abertos trocam o estilo ao reabrir; a tela de bloqueio muda no próximo login.)"
